# Overlay for the "QA · Images" worker. Values here override .env.
# Keep QA_MODE=template until Part 3 is implemented.
QA_MODE=template
COWORKER_ID=
STATE_DIR=.local/image
SOKOSUMI_ORGANIZATION_ID=
SOKOSUMI_ORGANIZATION_SLUG=
# Object detector (Step 4.6 benchmark, docs/detector-choice.md). Blank = defaults below.
DETECTOR_MODEL=Xenova/owlv2-base-patch16
DETECTOR_DTYPE=q8
DETECTOR_THRESHOLD=0.15
